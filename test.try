load "main.try";
use TrypLogger.Logger;
use TrypLogger.LogLevel;

describe("TrypLogger Test Suite", fn() {
    it("should initialize with correct default values", fn() {
        let log = Logger("TestModule");
        assertEq(log.name, "TestModule");
        assertEq(log.minLevel, LogLevel["DEBUG"]);
        assertEq(log.jsonMode, false);
    });

    it("should update minimum log level correctly", fn() {
        let log = Logger("TestModule");
        log.setLevel(LogLevel["WARN"]);
        assertEq(log.minLevel, LogLevel["WARN"]);
    });

    it("should enable JSON mode", fn() {
        let log = Logger("TestModule");
        log.enableJson(true);
        assertEq(log.jsonMode, true);
    });
});
